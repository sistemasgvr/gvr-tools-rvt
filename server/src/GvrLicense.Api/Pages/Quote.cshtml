@page
@model GvrLicense.Api.Pages.QuoteModel
@{
    ViewData["Title"] = "Cotiza";
    Layout = "_PublicLayout";
    ViewData["SupportEmail"] = Model.SupportEmail;
    ViewData["TosUrl"] = Model.TosUrl;
    ViewData["PrivacyUrl"] = Model.PrivacyUrl;
}

<div class="container pt-4">
    <a href="/download" class="d-inline-flex align-items-center gap-1 text-body-secondary text-decoration-none small">
        <i class="bi bi-arrow-left" aria-hidden="true"></i> Volver a Descargar
    </a>
</div>

<section class="public-hero">
    <div class="container">
        <img src="~/img/escudo-gvr.png" alt="GVR TOOLS-RVT" class="public-hero-logo mb-3" width="96" height="96" />
        <p class="text-body-secondary text-uppercase small fw-semibold mb-2">Cotización</p>
        <h1>Elige tu plan</h1>
        <p class="lead text-body-secondary">
            Cuéntanos qué necesitas y te contactamos con los detalles y la clave de licencia.
        </p>
    </div>
</section>

@if (Model.Plans.Count > 0)
{
    <section class="container pb-4">
        <div class="row g-4 justify-content-center">
            @foreach (var plan in Model.Plans)
            {
                <div class="col-12 col-md-4">
                    <div class="card public-plan-card h-100 @(string.Equals(plan.Code, Model.Input.PlanCode, StringComparison.OrdinalIgnoreCase) ? "border-primary" : "border-body-secondary border-opacity-25")">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <span class="public-plan-icon">
                                    <i class="bi bi-box-seam" aria-hidden="true"></i>
                                </span>
                                <h3 class="card-title h5 mb-0">@plan.DisplayName</h3>
                            </div>
                            @if (plan.FeatureSummary.Count > 0)
                            {
                                <ul class="list-unstyled small mb-4 flex-grow-1">
                                    @foreach (var line in plan.FeatureSummary)
                                    {
                                        <li class="d-flex align-items-center gap-2 mb-2">
                                            <span class="public-feature-icon">
                                                <i class="bi @line.Icon" aria-hidden="true"></i>
                                            </span>
                                            <span class="text-body-secondary">@line.Text</span>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <div class="flex-grow-1 mb-4"></div>
                            }
                            <a href="#cotizar" class="btn btn-outline-primary mt-auto d-inline-flex align-items-center justify-content-center gap-1" data-plan-code="@plan.Code">
                                Cotizar @plan.DisplayName <i class="bi bi-arrow-right" aria-hidden="true"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

<section id="cotizar" class="container pb-5" style="max-width: 640px">
    <div class="card">
        <div class="card-body p-4">
            @if (Model.Submitted)
            {
                <div class="alert alert-success mb-0 d-flex align-items-center gap-2" role="status">
                    <i class="bi bi-check-circle-fill fs-4" aria-hidden="true"></i>
                    <span>¡Listo! Recibimos tu solicitud, te contactamos pronto.</span>
                </div>
            }
            else
            {
                <div class="d-flex align-items-center gap-2 mb-1">
                    <i class="bi bi-chat-square-text text-primary fs-4" aria-hidden="true"></i>
                    <h2 class="h5 mb-0">Solicita tu cotización</h2>
                </div>
                <p class="text-body-secondary small mb-4">
                    <i class="bi bi-shield-check me-1" aria-hidden="true"></i>
                    Tus datos solo se usan para responder a tu cotización.
                </p>

                <form method="post" novalidate class="public-form">
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
                            <i class="bi bi-exclamation-triangle-fill mt-1" aria-hidden="true"></i>
                            <ul class="mb-0 ps-3">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label">Nombre completo</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person" aria-hidden="true"></i></span>
                                <input name="Input.FullName" class="form-control" value="@Model.Input.FullName" required />
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">Correo</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope" aria-hidden="true"></i></span>
                                <input name="Input.Email" type="email" class="form-control" value="@Model.Input.Email" required />
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">Teléfono / WhatsApp <span class="text-body-secondary">(opcional)</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-telephone" aria-hidden="true"></i></span>
                                <input name="Input.Phone" class="form-control" value="@Model.Input.Phone" />
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">Empresa <span class="text-body-secondary">(opcional)</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-building" aria-hidden="true"></i></span>
                                <input name="Input.CompanyName" class="form-control" value="@Model.Input.CompanyName" />
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Plan de interés</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-diagram-3" aria-hidden="true"></i></span>
                                <select name="Input.PlanCode" class="form-select" id="plan-select">
                                    <option value="">No estoy seguro / quiero que me asesoren</option>
                                    @foreach (var plan in Model.Plans)
                                    {
                                        <option value="@plan.Code" selected="@(string.Equals(plan.Code, Model.Input.PlanCode, StringComparison.OrdinalIgnoreCase))">@plan.DisplayName</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Cuéntanos qué necesitas <span class="text-body-secondary">(opcional)</span></label>
                            <div class="input-group">
                                <span class="input-group-text align-items-start pt-2"><i class="bi bi-chat-text" aria-hidden="true"></i></span>
                                <textarea name="Input.Message" class="form-control" rows="3">@Model.Input.Message</textarea>
                            </div>
                        </div>
                    </div>

                    @* Honeypot: oculto por CSS, no por "display:none" del atributo (algunos bots lo detectan);
                       fuera de la vista y sin tabIndex para que un humano nunca lo note ni lo llene por accidente. *@
                    <div class="visually-hidden" aria-hidden="true">
                        <label for="website">No llenar este campo</label>
                        <input type="text" id="website" name="Input.Website" tabindex="-1" autocomplete="off" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mt-4 d-inline-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-send" aria-hidden="true"></i> Enviar solicitud
                    </button>
                </form>
            }
        </div>
    </div>
</section>

@* _PublicLayout no define una sección "Scripts" (a diferencia del _Layout de Admin) -- este script
   va directo en el cuerpo de la página, dentro de lo que @RenderBody() del layout renderiza. *@
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const select = document.getElementById('plan-select');
    if (!select) return;
    document.querySelectorAll('[data-plan-code]').forEach((btn) => {
      btn.addEventListener('click', () => { select.value = btn.dataset.planCode; });
    });
  });
</script>
