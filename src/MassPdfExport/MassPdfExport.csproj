<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Revit 2021-2024 all run on .NET Framework 4.8. Revit 2025+ moved to .NET 8
         and needs a separate build (see README "Extending to newer Revit versions"). -->
    <TargetFramework>net48</TargetFramework>
    <RevitVersion>2021</RevitVersion>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>GvrTools.MassPdfExport</AssemblyName>
    <RootNamespace>GvrTools.MassPdfExport</RootNamespace>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>GVR Tools - Exportador PDF Masivo</Product>
    <Company>GVR</Company>
    <Version>1.0.0</Version>
    <NeutralLanguage>es</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference-only assemblies for the Revit 2021 API (compile-time only; the
         real RevitAPI.dll/RevitAPIUI.dll are supplied by Revit itself at runtime). -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2021.1.50" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2021.1.50" />
  </ItemGroup>

</Project>
