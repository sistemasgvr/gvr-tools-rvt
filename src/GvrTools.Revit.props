<Project>

  <!--
    Imported by every project that talks to the Revit API. Keeps the reference-assembly packages
    and the per-release target framework in exactly one place.

    `ExcludeAssets="runtime"` matters: these packages are compile-time contracts only. Revit
    supplies the real RevitAPI.dll / RevitAPIUI.dll at runtime, and shipping our own copy next to
    the add-in is a classic cause of "type X cannot be cast to type X" load failures.
  -->

  <PropertyGroup>
    <TargetFramework>$(RevitTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- Cumulative version symbols: a 2024 build defines REVIT2024 plus REVIT2021_OR_GREATER through
       REVIT2024_OR_GREATER. Code guards features with the *_OR_GREATER form, so supporting a new
       Revit release is a one-line change here and no source edits at all. -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' &gt;= '2021'">$(DefineConstants);REVIT2021_OR_GREATER</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' &gt;= '2022'">$(DefineConstants);REVIT2022_OR_GREATER</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' &gt;= '2023'">$(DefineConstants);REVIT2023_OR_GREATER</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' &gt;= '2024'">$(DefineConstants);REVIT2024_OR_GREATER</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' &gt;= '2025'">$(DefineConstants);REVIT2025_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
