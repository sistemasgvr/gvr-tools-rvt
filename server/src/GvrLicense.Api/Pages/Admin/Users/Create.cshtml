@page
@model GvrLicense.Api.Pages.Admin.Users.CreateModel
@{
    ViewData["Title"] = "Nuevo administrador";
}

@if (Model.Created)
{
    <div class="alert alert-success">
        Administrador <strong>@Model.Input.Username</strong> creado. Ya puede iniciar sesión con su contraseña.
        <a href="/Admin/Users/Index" class="alert-link">Ver administradores</a>
    </div>
}

<div class="card card-primary card-outline">
    <div class="card-header">
        <h3 class="card-title">Nuevo administrador</h3>
    </div>
    <form method="post">
        <div class="card-body" style="max-width: 28rem">
            <p class="text-body-secondary small">Quién podrá entrar a este panel. No es un usuario de Revit; es acceso al admin.</p>
            <div class="mb-3">
                <label asp-for="Input.Username" class="form-label">Usuario</label>
                <input asp-for="Input.Username" class="form-control" required autocomplete="off" />
            </div>
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label">Contraseña</label>
                <input asp-for="Input.Password" type="password" class="form-control" required minlength="8" autocomplete="new-password" />
                <div class="form-text">Mínimo 8 caracteres.</div>
            </div>
            <div asp-validation-summary="All" class="text-danger"></div>
        </div>
        <div class="card-footer d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-1" aria-hidden="true"></i> Crear
            </button>
            <a href="/Admin/Users/Index" class="btn btn-outline-secondary">Volver</a>
        </div>
    </form>
</div>
