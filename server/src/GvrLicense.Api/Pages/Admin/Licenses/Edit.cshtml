@page
@model GvrLicense.Api.Pages.Admin.Licenses.EditModel
@{
    ViewData["Title"] = "Editar licencia";
}

@if (TempData["Saved"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        Licencia actualizada. El cliente verá los cambios en el próximo heartbeat.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (TempData["Kicked"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        Dispositivo liberado. En ese PC el add-in lo detectará en unos ~30 segundos
        (o al abrir Exportar láminas) y pedirá activar de nuevo.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="card card-primary card-outline mb-3">
    <div class="card-header">
        <h3 class="card-title">Editar licencia</h3>
        <div class="card-tools">
            <code class="small">@Model.LicenseKey</code>
            <span class="text-body-secondary">· @Model.CustomerName</span>
        </div>
    </div>
    <form method="post">
        <input asp-for="Id" type="hidden" />
        <div class="card-body">
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Input.PlanId" class="form-label">Plan</label>
                    <select asp-for="Input.PlanId" asp-items="Model.PlanOptions" class="form-select" id="license-plan-select" required></select>
                    <div class="form-text">Base de capacidades. Al cambiar el plan se recargan las opciones de abajo.</div>
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.ValidUntil" class="form-label">Fecha de vencimiento</label>
                    <input asp-for="Input.ValidUntil" type="date" class="form-control" required />
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.MaxUsers" class="form-label">Máx. usuarios</label>
                    <input asp-for="Input.MaxUsers" type="number" min="1" class="form-control" required />
                    <div class="form-text">Personas de la empresa que pueden activar.</div>
                </div>
            </div>

            <hr class="my-4" />

            <h5 class="mb-2">Qué puede usar esta licencia</h5>
            <p class="text-body-secondary small mb-3">
                Valores actuales (plan + ajustes). Si cambias algo respecto al plan, se guarda solo la diferencia.
                Plan base: <strong id="plan-summary-text">@Model.PlanSummary</strong>
            </p>

            <div id="license-features-editor">
            <partial name="~/Pages/Shared/_PlanFeaturesEditor.cshtml" for="Input.Features" />
            </div>
        </div>
        <div class="card-footer d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-1" aria-hidden="true"></i> Guardar cambios
            </button>
            <a href="/Admin/Licenses/Index" class="btn btn-outline-secondary">Volver a licencias</a>
        </div>
    </form>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card card-outline">
            <div class="card-header">
                <h3 class="card-title">Dispositivos (PCs)</h3>
            </div>
            <div class="card-body p-0">
                @if (Model.Devices.Count == 0)
                {
                    <p class="text-secondary p-3 mb-0">Nadie ha activado esta licencia todavía.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th>PC</th>
                                    <th>Usuario</th>
                                    <th>Correo</th>
                                    <th>Última vez</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var d in Model.Devices)
                            {
                                <tr>
                                    <td>@d.Label</td>
                                    <td>@d.UserName</td>
                                    <td><code class="small">@d.UserEmail</code></td>
                                    <td>@d.LastSeenUtc.ToString("dd/MM/yyyy HH:mm") UTC</td>
                                    <td class="text-end">
                                        <form method="post" asp-page-handler="KickDevice" asp-route-id="@Model.Id" class="d-inline"
                                              onsubmit="return confirm('¿Liberar este PC? Dejará de contar como puesto ocupado.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="deviceId" value="@d.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Liberar</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <div class="card-footer text-body-secondary small">
                Cada fila es un PC activado. El correo identifica al usuario (seat): la misma persona debe
                usar el mismo correo en todos sus equipos; otro correo distinto consume otro usuario.
                “Liberar” quita el puesto. El add-in en ese PC pierde la licencia en el próximo
                heartbeat (~30 s) o al abrir Exportar láminas.
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card card-outline">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title mb-0">Uso este mes (UTC)</h3>
                <span class="badge text-bg-secondary" id="usage-live-badge">En vivo</span>
            </div>
            <div class="card-body p-0">
                <p class="text-secondary p-3 mb-0@(Model.UsageRows.Count == 0 ? "" : " d-none")" id="usage-empty">Sin consumo registrado este mes.</p>
                <div class="table-responsive@(Model.UsageRows.Count == 0 ? " d-none" : "")" id="usage-table-wrap">
                    <table class="table table-striped mb-0 align-middle">
                        <thead>
                            <tr>
                                <th>Función</th>
                                <th>Usado</th>
                                <th>Límite</th>
                            </tr>
                        </thead>
                        <tbody id="usage-rows">
                        @foreach (var u in Model.UsageRows)
                        {
                            var limitLabel = u.QuotaLimit < 0 ? "Ilimitado" : u.QuotaLimit.ToString();
                            var featureLabel = u.FeatureCode switch
                            {
                                "quota.sheets_per_month" => "Láminas exportadas",
                                _ => u.FeatureCode
                            };
                            <tr data-feature="@u.FeatureCode">
                                <td>@featureLabel</td>
                                <td class="usage-consumed">@u.Consumed</td>
                                <td class="usage-limit">@limitLabel</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
(() => {
  const planSelect = document.getElementById('license-plan-select');
  const planSummary = document.getElementById('plan-summary-text');
  let confirmedPlanId = planSelect?.value;

  const setField = (name, value) => {
    const el = document.querySelector(`[name="${name}"]`);
    if (!el) return;
    if (el.type === 'checkbox') {
      el.checked = !!value;
      el.dispatchEvent(new Event('change'));
    } else {
      el.value = value ?? '';
    }
  };

  const applyPlanFeatures = (features) => {
    if (!features) return;
    setField('Input.Features.ToolBatchExport', features.toolBatchExport);
    setField('Input.Features.FormatPdf', features.formatPdf);
    setField('Input.Features.FormatDwg', features.formatDwg);
    setField('Input.Features.FormatPdfDwg', features.formatPdfDwg);
    setField('Input.Features.UpdatesStable', features.updatesStable);
    setField('Input.Features.SheetsPerMonth', features.sheetsPerMonth);
    setField('Input.Features.SheetsPerMonthUnlimited', features.sheetsPerMonthUnlimited);
    setField('Input.Features.SheetsPerBatch', features.sheetsPerBatch);
    setField('Input.Features.MaxDevicesPerUser', features.maxDevicesPerUser);
    setField('Input.Features.ExtraFeaturesText', features.extraFeaturesText);
  };

  planSelect?.addEventListener('change', async () => {
    const nextPlanId = planSelect.value;
    if (!nextPlanId || nextPlanId === confirmedPlanId) return;

    const ok = confirm(
      '¿Cargar las capacidades del plan seleccionado?\n\nSe actualizarán las opciones de "Qué puede usar esta licencia" con los valores base del plan.'
    );
    if (!ok) {
      planSelect.value = confirmedPlanId;
      return;
    }

    try {
      const res = await fetch(`/Admin/Licenses/Edit?handler=PlanFeatures&planId=${encodeURIComponent(nextPlanId)}`, {
        headers: { 'Accept': 'application/json' },
        credentials: 'same-origin'
      });
      if (!res.ok) throw new Error('plan fetch failed');
      const data = await res.json();
      applyPlanFeatures(data.features);
      if (planSummary && data.summary) planSummary.textContent = data.summary;
      confirmedPlanId = nextPlanId;
    } catch {
      alert('No se pudo cargar el plan. Intenta de nuevo.');
      planSelect.value = confirmedPlanId;
    }
  });
})();
</script>

<script>
(() => {
  const licenseId = @Json.Serialize(Model.Id);
  const tbody = document.getElementById('usage-rows');
  const empty = document.getElementById('usage-empty');
  const tableWrap = document.getElementById('usage-table-wrap');
  const badge = document.getElementById('usage-live-badge');
  if (!licenseId) return;

  const renderRows = (rows) => {
    if (!rows || rows.length === 0) {
      if (tbody) tbody.innerHTML = '';
      if (tableWrap) tableWrap.classList.add('d-none');
      if (empty) empty.classList.remove('d-none');
      return;
    }
    if (empty) empty.classList.add('d-none');
    if (tableWrap) tableWrap.classList.remove('d-none');
    if (!tbody) return;
    tbody.innerHTML = rows.map(r => `
      <tr data-feature="${r.featureCode}">
        <td>${r.label}</td>
        <td class="usage-consumed">${r.consumed}</td>
        <td class="usage-limit">${r.limitLabel}</td>
      </tr>`).join('');
  };

  const refreshUsage = async () => {
    try {
      const res = await fetch(`/Admin/Licenses/Edit?id=${encodeURIComponent(licenseId)}&handler=Usage`, {
        headers: { 'Accept': 'application/json' },
        credentials: 'same-origin'
      });
      if (!res.ok) {
        if (badge) badge.textContent = 'Sin conexión';
        return;
      }
      const rows = await res.json();
      renderRows(rows);
      if (badge) badge.textContent = 'En vivo';
    } catch {
      if (badge) badge.textContent = 'Sin conexión';
    }
  };

  refreshUsage();
  setInterval(refreshUsage, 15000);
})();
</script>
