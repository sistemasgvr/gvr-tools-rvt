@page
@model GvrLicense.Api.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Administradores";
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h3 class="card-title mb-0">Administradores</h3>
        <div class="d-flex gap-2">
            <input type="search" class="form-control form-control-sm" style="min-width: 16rem" placeholder="Buscar por usuario…"
                   oninput="gvrFilterTable(this, '#adminsTable tbody')" />
            <button type="button" class="btn btn-primary btn-sm text-nowrap" data-bs-toggle="modal" data-bs-target="#createAdminModal">
                <i class="bi bi-shield-lock me-1"></i> Nuevo administrador
            </button>
        </div>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0" id="adminsTable">
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Estado</th>
                    <th>Alta</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var row in Model.Rows)
            {
                var isSelf = row.Username == User.Identity?.Name;
                <tr data-search-row>
                    <td>
                        @row.Username
                        @if (isSelf)
                        {
                            <span class="badge text-bg-info ms-1">tú</span>
                        }
                    </td>
                    <td><span class="badge @(row.IsActive ? "text-bg-success" : "text-bg-secondary")">@(row.IsActive ? "Activo" : "Desactivado")</span></td>
                    <td>@row.CreatedAtUtc.ToString("yyyy-MM-dd")</td>
                    <td>
                        @if (!isSelf)
                        {
                            <form method="post" asp-page-handler="Toggle" asp-route-userId="@row.Id">
                                <button type="submit" class="btn btn-sm @(row.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                    @(row.IsActive ? "Desactivar" : "Reactivar")
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="createAdminModal" tabindex="-1" aria-labelledby="createAdminModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="/Admin/Users/Create">
                <div class="modal-header">
                    <h5 class="modal-title" id="createAdminModalLabel">Nuevo administrador</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Usuario</label>
                        <input name="Input.Username" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Contraseña</label>
                        <input name="Input.Password" type="password" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Crear</button>
                </div>
            </form>
        </div>
    </div>
</div>
