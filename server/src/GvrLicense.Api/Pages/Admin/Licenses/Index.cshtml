@page
@model GvrLicense.Api.Pages.Admin.Licenses.IndexModel
@{
    ViewData["Title"] = "Licencias";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h3 class="card-title mb-0">Licencias</h3>
        <div class="d-flex gap-2">
            <input type="search" class="form-control form-control-sm" style="min-width: 16rem" placeholder="Buscar por key, cliente, plan…"
                   oninput="gvrFilterTable(this, '#licensesTable tbody')" />
            <button type="button" class="btn btn-primary btn-sm text-nowrap" data-bs-toggle="modal" data-bs-target="#createLicenseModal">
                <i class="bi bi-key me-1"></i> Nueva licencia
            </button>
        </div>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0" id="licensesTable">
            <thead>
                <tr>
                    <th>Key</th>
                    <th>Cliente</th>
                    <th>Plan</th>
                    <th>Estado</th>
                    <th>Vence</th>
                    <th>Devices</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Rows.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-secondary p-3">Sin licencias todavía -- crea la primera con el botón de arriba.</td></tr>
            }
            @foreach (var row in Model.Rows)
            {
                var badgeClass = row.Status switch
                {
                    GvrLicense.Domain.Entities.LicenseStatus.Active => "text-bg-success",
                    GvrLicense.Domain.Entities.LicenseStatus.Suspended => "text-bg-warning",
                    _ => "text-bg-danger"
                };
                <tr data-search-row>
                    <td><code>@row.Key</code></td>
                    <td>@row.CustomerName</td>
                    <td>@row.PlanCode</td>
                    <td><span class="badge @badgeClass">@row.Status</span></td>
                    <td>@row.ValidUntil.ToString("yyyy-MM-dd")</td>
                    <td>@row.DeviceCount / @row.MaxDevices</td>
                    <td>
                        <form method="post" asp-page-handler="Toggle" asp-route-licenseId="@row.Id">
                            <button type="submit" class="btn btn-sm @(row.Status == GvrLicense.Domain.Entities.LicenseStatus.Active ? "btn-outline-warning" : "btn-outline-success")">
                                @(row.Status == GvrLicense.Domain.Entities.LicenseStatus.Active ? "Suspender" : "Reactivar")
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="createLicenseModal" tabindex="-1" aria-labelledby="createLicenseModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="/Admin/Licenses/Create">
                <div class="modal-header">
                    <h5 class="modal-title" id="createLicenseModalLabel">Nueva licencia</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    @if (Model.CustomerOptions.Count == 0)
                    {
                        <p class="text-warning"><i class="bi bi-exclamation-triangle me-1"></i> No hay clientes todavía -- crea uno primero.</p>
                    }
                    @if (Model.PlanOptions.Count == 0)
                    {
                        <p class="text-warning"><i class="bi bi-exclamation-triangle me-1"></i> No hay planes cargados en la base todavía.</p>
                    }
                    <div class="mb-3">
                        <label class="form-label">Cliente</label>
                        <select name="Input.CustomerId" asp-items="Model.CustomerOptions" class="form-select" required></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Plan</label>
                        <select name="Input.PlanId" asp-items="Model.PlanOptions" class="form-select" required></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Vence (UTC)</label>
                        <input name="Input.ValidUntil" type="date" class="form-control" value="@DateOnly.FromDateTime(DateTime.UtcNow.AddYears(1)).ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Máx. dispositivos</label>
                        <input name="Input.MaxDevices" type="number" min="1" value="1" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Crear licencia</button>
                </div>
            </form>
        </div>
    </div>
</div>
