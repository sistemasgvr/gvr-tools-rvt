<Project>

  <!--
    Shared build configuration for every project under src/.

    ONE knob drives the whole Revit matrix: the `RevitVersion` property. It selects the target
    framework, the Revit API reference package and the REVITxxxx_OR_GREATER compilation symbols,
    so the same source tree compiles for Revit 2021 through 2025.

      dotnet build src/GvrTools.App -c Release -p:RevitVersion=2025

    Visual Studio users can instead pick a "Debug R25" / "Release R25" configuration; the version
    is inferred from the configuration name below.
  -->

  <PropertyGroup>
    <Configurations>Debug;Release;Debug R21;Release R21;Debug R22;Release R22;Debug R23;Release R23;Debug R24;Release R24;Debug R25;Release R25</Configurations>
    <GvrRepoRoot>$(MSBuildThisFileDirectory)..\</GvrRepoRoot>
    <GvrBuildRoot>$(GvrRepoRoot)build\</GvrBuildRoot>
  </PropertyGroup>

  <!-- Infer RevitVersion from the configuration name when it was not passed explicitly. -->
  <PropertyGroup Condition="'$(RevitVersion)' == ''">
    <RevitVersion Condition="$(Configuration.Contains('R21'))">2021</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('R22'))">2022</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('R23'))">2023</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('R24'))">2024</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('R25'))">2025</RevitVersion>
    <!-- Default target: the oldest supported release, so a plain `dotnet build` always exercises
         the most constrained code path (Revit 2021, which has no native PDF export API). -->
    <RevitVersion Condition="'$(RevitVersion)' == ''">2021</RevitVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Revit 2021-2024 run on .NET Framework 4.8; Revit 2025+ runs on .NET 8. -->
    <RevitTargetFramework>net48</RevitTargetFramework>
    <RevitTargetFramework Condition="'$(RevitVersion)' &gt;= '2025'">net8.0-windows</RevitTargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NeutralLanguage>es</NeutralLanguage>
    <Company>GVR</Company>
    <Product>GVR Tools para Revit</Product>
    <Version>2.0.0</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
    <AssemblyInformationalVersion>$(Version)</AssemblyInformationalVersion>
    <!-- Revit add-ins load into a host process that already has its own copies of most common
         NuGet libraries. Every runtime dependency we ship is a potential assembly-version clash,
         so this solution deliberately has ZERO runtime NuGet dependencies: the only packages
         referenced are compile-time-only Revit API reference assemblies. -->
    <NoWarn>$(NoWarn);NU1701;MSB3277;CS1591</NoWarn>
  </PropertyGroup>

  <!-- The REVITxxxx symbols deliberately live in GvrTools.Revit.props, not here: only the projects
       that talk to the Revit API should be recompiled when the target release changes. Keeping them
       out of the version-agnostic libraries is what lets Core and UI build once and be reused. -->

</Project>
