<!--
    Single source of truth for how every GVR Tools window looks.

    A tool window merges this dictionary and then only uses the keys below, so adding a second or
    tenth tool costs no design work and the whole suite keeps one identity:

        <Window.Resources>
            <ResourceDictionary Source="pack://application:,,,/GvrTools.UI;component/Theme/GvrTheme.xaml"/>
        </Window.Resources>
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette -->
    <Color x:Key="Gvr.Color.Accent">#FF1565C0</Color>
    <Color x:Key="Gvr.Color.Success">#FF2E7D32</Color>
    <Color x:Key="Gvr.Color.Danger">#FFC62828</Color>
    <Color x:Key="Gvr.Color.Ink">#FF212121</Color>
    <Color x:Key="Gvr.Color.Muted">#FF6B7280</Color>
    <Color x:Key="Gvr.Color.Line">#FFDCE0E4</Color>
    <Color x:Key="Gvr.Color.Surface">#FFF6F7F9</Color>

    <SolidColorBrush x:Key="Gvr.Brush.Accent" Color="{StaticResource Gvr.Color.Accent}"/>
    <SolidColorBrush x:Key="Gvr.Brush.Success" Color="{StaticResource Gvr.Color.Success}"/>
    <SolidColorBrush x:Key="Gvr.Brush.Danger" Color="{StaticResource Gvr.Color.Danger}"/>
    <SolidColorBrush x:Key="Gvr.Brush.Ink" Color="{StaticResource Gvr.Color.Ink}"/>
    <SolidColorBrush x:Key="Gvr.Brush.Muted" Color="{StaticResource Gvr.Color.Muted}"/>
    <SolidColorBrush x:Key="Gvr.Brush.Line" Color="{StaticResource Gvr.Color.Line}"/>
    <SolidColorBrush x:Key="Gvr.Brush.Surface" Color="{StaticResource Gvr.Color.Surface}"/>

    <!-- Metrics. Only WPF's own types are declared here on purpose: pulling System.Double into a
         dictionary needs a clr-namespace mapping whose assembly name differs between .NET Framework
         and .NET 8, and this suite builds for both. -->
    <Thickness x:Key="Gvr.Padding.Window">14</Thickness>
    <Thickness x:Key="Gvr.Padding.Card">12</Thickness>

    <BooleanToVisibilityConverter x:Key="Gvr.BoolToVisibility"/>

    <!-- Text -->
    <Style x:Key="Gvr.Text.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Gvr.Brush.Ink}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="Gvr.Text.Subtle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Gvr.Brush.Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Gvr.Text.Label" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Foreground" Value="{StaticResource Gvr.Brush.Ink}"/>
    </Style>

    <Style x:Key="Gvr.Text.SectionHeader" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Foreground" Value="{StaticResource Gvr.Brush.Ink}"/>
    </Style>

    <!-- Containers -->
    <Style x:Key="Gvr.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Gvr.Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Gvr.Brush.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="{StaticResource Gvr.Padding.Card}"/>
    </Style>

    <!-- Inputs -->
    <Style x:Key="Gvr.TextBox" TargetType="TextBox">
        <Setter Property="Padding" Value="5,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Gvr.ComboBox" TargetType="ComboBox">
        <Setter Property="Padding" Value="5,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Gvr.CheckBox" TargetType="CheckBox">
        <Setter Property="Margin" Value="0,0,18,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Buttons -->
    <Style x:Key="Gvr.Button" TargetType="Button">
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="MinWidth" Value="76"/>
    </Style>

    <Style x:Key="Gvr.Button.Action" TargetType="Button" BasedOn="{StaticResource Gvr.Button}">
        <Setter Property="Padding" Value="18,7"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="MinWidth" Value="120"/>
    </Style>

    <Style x:Key="Gvr.Button.Primary" TargetType="Button" BasedOn="{StaticResource Gvr.Button.Action}">
        <Setter Property="Background" Value="{StaticResource Gvr.Brush.Success}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource Gvr.Brush.Line}"/>
                <Setter Property="Foreground" Value="{StaticResource Gvr.Brush.Muted}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Wizard step tabs (ProSheets-like chrome) -->
    <Style x:Key="Gvr.WizardTab" TargetType="Button" BasedOn="{StaticResource Gvr.Button}">
        <Setter Property="Padding" Value="4,6"/>
        <Setter Property="Margin" Value="0,0,18,0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Gvr.Brush.Muted}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Gvr.Brush.Line}"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Gvr.Brush.Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Gvr.FormatOption" TargetType="Button" BasedOn="{StaticResource Gvr.Button}">
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="MinWidth" Value="100"/>
        <Setter Property="Background" Value="{StaticResource Gvr.Brush.Surface}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource Gvr.Brush.Line}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Data grid -->
    <Style x:Key="Gvr.DataGrid" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserReorderColumns" Value="False"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Gvr.Brush.Line}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Gvr.Brush.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource Gvr.Brush.Surface}"/>
        <Setter Property="SelectionMode" Value="Extended"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    </Style>

</ResourceDictionary>
