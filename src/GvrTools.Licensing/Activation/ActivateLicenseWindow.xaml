<Window x:Class="GvrTools.Licensing.Activation.ActivateLicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GVR Tools · Activar licencia"
        Height="420" Width="460" MinHeight="380" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/GvrTools.UI;component/Theme/GvrTheme.xaml"/>
    </Window.Resources>

    <Grid Margin="{StaticResource Gvr.Padding.Window}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Activar licencia" Style="{StaticResource Gvr.Text.Title}"/>
            <TextBlock Text="Pega la clave que te enviamos y tus datos. Cada colaborador usa su propio correo."
                       Style="{StaticResource Gvr.Text.Subtle}" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Clave de licencia" Style="{StaticResource Gvr.Text.Label}" Margin="0,0,0,4"/>
            <TextBox Style="{StaticResource Gvr.TextBox}" Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12"/>

            <TextBlock Text="Nombre completo" Style="{StaticResource Gvr.Text.Label}" Margin="0,0,0,4"/>
            <TextBox Style="{StaticResource Gvr.TextBox}" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12"/>

            <TextBlock Text="Correo" Style="{StaticResource Gvr.Text.Label}" Margin="0,0,0,4"/>
            <TextBox Style="{StaticResource Gvr.TextBox}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,8"/>

            <TextBlock Text="{Binding SupportHint}" Style="{StaticResource Gvr.Text.Subtle}"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Gvr.Brush.Danger}"
                       TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Conectando…" Margin="0,0,0,8"
                   Foreground="{StaticResource Gvr.Brush.Muted}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Style="{StaticResource Gvr.Button}" Command="{Binding CancelCommand}"/>
            <Button Content="Activar" Style="{StaticResource Gvr.Button.Primary}" Command="{Binding ActivateCommand}"/>
        </StackPanel>
    </Grid>
</Window>
