<Window x:Class="GvrTools.Licensing.Activation.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GVR Tools · Actualización disponible"
        Height="280" Width="440" MinHeight="240" MinWidth="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/GvrTools.UI;component/Theme/GvrTheme.xaml"/>
    </Window.Resources>

    <Grid Margin="{StaticResource Gvr.Padding.Window}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Hay una nueva versión" Style="{StaticResource Gvr.Text.Title}"/>
            <TextBlock Style="{StaticResource Gvr.Text.Subtle}" Margin="0,6,0,0">
                <Run Text="Tu versión:"/>
                <Run Text="{Binding CurrentVersion}" FontWeight="SemiBold"/>
                <Run Text="  →  "/>
                <Run Text="Nueva:"/>
                <Run Text="{Binding LatestVersion}" FontWeight="SemiBold"/>
            </TextBlock>
            <TextBlock Text="{Binding Notes}" Style="{StaticResource Gvr.Text.Subtle}" Margin="0,10,0,0"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Gvr.Brush.Danger}"
                       TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Más tarde" Style="{StaticResource Gvr.Button}" Command="{Binding LaterCommand}"/>
            <Button Content="Descargar e instalar" Style="{StaticResource Gvr.Button.Primary}"
                    Command="{Binding DownloadCommand}"/>
        </StackPanel>
    </Grid>
</Window>
