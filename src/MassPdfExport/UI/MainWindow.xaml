<Window x:Class="GvrTools.MassPdfExport.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GVR Tools - Exportación PDF Masiva"
        Height="660" Width="860" MinHeight="500" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="Button" x:Key="ToolbarButton">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: header -->
            <RowDefinition Height="Auto"/>   <!-- 1: selection toolbar -->
            <RowDefinition Height="*"/>      <!-- 2: sheet grid -->
            <RowDefinition Height="Auto"/>   <!-- 3: output folder -->
            <RowDefinition Height="Auto"/>   <!-- 4: naming pattern -->
            <RowDefinition Height="Auto"/>   <!-- 5: print options (printer, margen, zoom, tamaño) -->
            <RowDefinition Height="Auto"/>   <!-- 6: open-folder option -->
            <RowDefinition Height="Auto"/>   <!-- 7: progress / status -->
            <RowDefinition Height="Auto"/>   <!-- 8: action buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="GVR Tools · Exportación PDF Masiva" FontSize="17" FontWeight="Bold"/>
            <TextBlock Text="{Binding DocumentTitle, StringFormat=' — {0}'}" FontSize="17" Foreground="#666"/>
        </StackPanel>

        <!-- Selection toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Todas" Style="{StaticResource ToolbarButton}" Command="{Binding SelectAllCommand}"/>
            <Button Grid.Column="1" Content="Ninguna" Style="{StaticResource ToolbarButton}" Command="{Binding SelectNoneCommand}"/>
            <Button Grid.Column="2" Content="Invertir" Style="{StaticResource ToolbarButton}" Command="{Binding InvertSelectionCommand}"/>

            <TextBlock Grid.Column="4" Text="Buscar:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Grid.Column="5" VerticalContentAlignment="Center" Padding="4,3"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Column="6" Text="Set de láminas:" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <ComboBox Grid.Column="7" ItemsSource="{Binding SheetSetNames}" SelectedItem="{Binding SelectedSheetSet}"/>
        </Grid>

        <!-- Sheet grid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding SheetsView}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                  SelectionMode="Extended" GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                  AlternatingRowBackground="#F5F5F5" IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="36"/>
                <DataGridTextColumn Header="N° Lámina" Binding="{Binding SheetNumber}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding SheetName}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Rev." Binding="{Binding RevisionNumber}" Width="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="Descripción de revisión" Binding="{Binding RevisionDescription}" Width="220" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Output folder -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Carpeta de destino:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Row="0" Grid.Column="1" Padding="4,3" VerticalContentAlignment="Center"
                     Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Row="0" Grid.Column="2" Content="Examinar..." Style="{StaticResource ToolbarButton}" Margin="8,0,0,0"
                    Command="{Binding BrowseFolderCommand}"/>

            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0" Foreground="#666" FontStyle="Italic"
                       Text="{Binding PreviewFolder, StringFormat='Se creará la carpeta: {0}'}"/>
        </Grid>

        <!-- Naming pattern -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nombre de archivo:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Row="0" Grid.Column="1" Padding="4,3" Text="{Binding NamingPattern, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Foreground="#666" FontSize="11"
                       Text="Tokens disponibles: {SheetNumber}  {SheetName}  {RevisionNumber}  {RevisionDescription}"/>
        </Grid>

        <!-- Print options -->
        <Border Grid.Row="5" Margin="0,12,0,0" Padding="10" Background="#F5F5F5" CornerRadius="3">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Impresora PDF:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="260"
                              ItemsSource="{Binding AvailablePrinters}" SelectedItem="{Binding SelectedPrinter}"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <CheckBox Content="Detectar tamaño de cada lámina" IsChecked="{Binding MatchSheetSize}" Margin="0,0,20,0"
                              ToolTip="Intenta usar el tamaño de papel real de cada lámina según su rótulo."/>
                    <CheckBox Content="Ajustar a la página" IsChecked="{Binding FitToPage}" Margin="0,0,20,0"
                              ToolTip="Si no está marcado, imprime a escala real 100%."/>
                    <CheckBox Content="Sin margen" IsChecked="{Binding NoMargin}"
                              ToolTip="Si no está marcado, usa el margen mínimo de la impresora."/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Open-folder option -->
        <CheckBox Grid.Row="6" Content="Abrir la carpeta de destino al finalizar la exportación"
                  IsChecked="{Binding OpenFolderWhenDone}" Margin="0,10,0,0"/>

        <!-- Progress / status -->
        <Grid Grid.Row="7" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ProgressBar Grid.Row="0" Height="16" Minimum="0" Maximum="{Binding ProgressTotal}" Value="{Binding ProgressCurrent, Mode=OneWay}"
                         Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Grid.Row="1" Margin="0,4,0,0" Text="{Binding StatusText}" Foreground="#444" TextWrapping="Wrap"/>
        </Grid>

        <!-- Action buttons -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Style="{StaticResource ActionButton}" Command="{Binding CancelCommand}"
                    Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}"/>
            <Button Content="Exportar PDF" Style="{StaticResource ActionButton}" Command="{Binding ExportCommand}"
                    Background="#2E7D32" Foreground="White" FontWeight="Bold"/>
            <Button Content="Cerrar" Style="{StaticResource ActionButton}" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
