@page
@model GvrLicense.Api.Pages.Admin.Licenses.EditModel
@{
    ViewData["Title"] = "Editar licencia";
}

@if (TempData["Saved"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        Licencia actualizada. El cliente verá los cambios en el próximo heartbeat.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (TempData["Kicked"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        Dispositivo liberado. En ese PC el add-in lo detectará en como máximo ~2 minutos
        (o al usar una herramienta) y pedirá activar de nuevo.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="card card-primary card-outline mb-3">
    <div class="card-header">
        <h3 class="card-title">Editar licencia</h3>
        <div class="card-tools">
            <code class="small">@Model.LicenseKey</code>
            <span class="text-body-secondary">· @Model.CustomerName</span>
        </div>
    </div>
    <form method="post">
        <input asp-for="Id" type="hidden" />
        <div class="card-body">
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Input.PlanId" class="form-label">Plan</label>
                    <select asp-for="Input.PlanId" asp-items="Model.PlanOptions" class="form-select" required></select>
                    <div class="form-text">Base de capacidades. Abajo puedes personalizar solo esta licencia.</div>
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.ValidUntil" class="form-label">Fecha de vencimiento</label>
                    <input asp-for="Input.ValidUntil" type="date" class="form-control" required />
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.MaxUsers" class="form-label">Máx. usuarios</label>
                    <input asp-for="Input.MaxUsers" type="number" min="1" class="form-control" required />
                    <div class="form-text">Personas de la empresa que pueden activar.</div>
                </div>
            </div>

            <hr class="my-4" />

            <h5 class="mb-2">Qué puede usar esta licencia</h5>
            <p class="text-body-secondary small mb-3">
                Valores actuales (plan + ajustes). Si cambias algo respecto al plan, se guarda solo la diferencia.
                Plan base: <strong>@Model.PlanSummary</strong>
            </p>

            <partial name="~/Pages/Shared/_PlanFeaturesEditor.cshtml" for="Input.Features" />
        </div>
        <div class="card-footer d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-1" aria-hidden="true"></i> Guardar cambios
            </button>
            <a href="/Admin/Licenses/Index" class="btn btn-outline-secondary">Volver a licencias</a>
        </div>
    </form>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card card-outline">
            <div class="card-header">
                <h3 class="card-title">Dispositivos (PCs)</h3>
            </div>
            <div class="card-body p-0">
                @if (Model.Devices.Count == 0)
                {
                    <p class="text-secondary p-3 mb-0">Nadie ha activado esta licencia todavía.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th>PC</th>
                                    <th>Usuario</th>
                                    <th>Última vez</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var d in Model.Devices)
                            {
                                <tr>
                                    <td>@d.Label</td>
                                    <td>@d.UserName</td>
                                    <td>@d.LastSeenUtc.ToString("dd/MM/yyyy HH:mm") UTC</td>
                                    <td class="text-end">
                                        <form method="post" asp-page-handler="KickDevice" asp-route-id="@Model.Id" class="d-inline"
                                              onsubmit="return confirm('¿Liberar este PC? Dejará de contar como puesto ocupado.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="deviceId" value="@d.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Liberar</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <div class="card-footer text-body-secondary small">
                “Liberar” quita el puesto. El add-in en ese PC pierde la licencia en el próximo
                heartbeat (~2 min) o al intentar exportar.
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card card-outline">
            <div class="card-header">
                <h3 class="card-title">Uso este mes (UTC)</h3>
            </div>
            <div class="card-body p-0">
                @if (Model.UsageRows.Count == 0)
                {
                    <p class="text-secondary p-3 mb-0">Sin consumo registrado este mes.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th>Función</th>
                                    <th>Usado</th>
                                    <th>Límite</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var u in Model.UsageRows)
                            {
                                var limitLabel = u.QuotaLimit < 0 ? "Ilimitado" : u.QuotaLimit.ToString();
                                var featureLabel = u.FeatureCode switch
                                {
                                    "quota.sheets_per_month" => "Láminas exportadas",
                                    _ => u.FeatureCode
                                };
                                <tr>
                                    <td>@featureLabel</td>
                                    <td>@u.Consumed</td>
                                    <td>@limitLabel</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
