@page
@using System.Text.Json
@using System.Text.Json.Serialization
@model GvrLicense.Api.Pages.Admin.Licenses.IndexModel
@{
    ViewData["Title"] = "Licencias";
}

<div class="card">
    <div class="card-header">
        <div class="row g-2 align-items-center">
            <div class="col-12 col-md-4">
                <h3 class="card-title">Licencias</h3>
            </div>
            <div class="col-12 col-md-8">
                <div class="d-flex flex-wrap justify-content-md-end gap-2">
                    <div class="input-group input-group-sm w-auto flex-grow-1 flex-md-grow-0" style="max-width: 16rem">
                        <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
                        <input id="licenses-filter" type="search" class="form-control" placeholder="Buscar…" aria-label="Buscar" style="min-width: 8rem" />
                    </div>
                    <button type="button" class="btn btn-primary btn-sm text-nowrap" data-bs-toggle="modal" data-bs-target="#createLicenseModal">
                        <i class="bi bi-key me-1" aria-hidden="true"></i> Nueva licencia
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div id="licenses-table"></div>
    </div>
</div>

<div class="modal fade" id="createLicenseModal" tabindex="-1" aria-labelledby="createLicenseModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="/Admin/Licenses/Create">
                <div class="modal-header">
                    <h5 class="modal-title" id="createLicenseModalLabel">Nueva licencia</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    @if (Model.CustomerOptions.Count == 0)
                    {
                        <p class="text-warning"><i class="bi bi-exclamation-triangle me-1"></i> No hay clientes todavía -- crea uno primero.</p>
                    }
                    @if (Model.PlanOptions.Count == 0)
                    {
                        <p class="text-warning"><i class="bi bi-exclamation-triangle me-1"></i> No hay planes cargados en la base todavía.</p>
                    }
                    <div class="mb-3">
                        <label class="form-label">Cliente</label>
                        <select name="Input.CustomerId" asp-items="Model.CustomerOptions" class="form-select" required></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Plan</label>
                        <select name="Input.PlanId" asp-items="Model.PlanOptions" class="form-select" required></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Vence (UTC)</label>
                        <input name="Input.ValidUntil" type="date" class="form-control" value="@DateOnly.FromDateTime(DateTime.UtcNow.AddYears(1)).ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Máx. dispositivos</label>
                        <input name="Input.MaxDevices" type="number" min="1" value="1" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Crear licencia</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const data = @Html.Raw(JsonSerializer.Serialize(Model.Rows, new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        Converters = { new JsonStringEnumConverter() } // Status es un enum -- sin esto, System.Text.Json lo manda como 0/1, no "Active"/"Suspended"
    }));
    const csrfToken = '@Model.AntiForgeryToken';

    const statusBadge = (cell) => {
      const map = { Active: 'success', Suspended: 'warning', Expired: 'danger' };
      const value = cell.getValue();
      return `<span class="badge text-bg-${map[value] || 'secondary'}">${value}</span>`;
    };

    const actionButton = (cell) => {
      const row = cell.getData();
      const isActive = row.status === 'Active';
      const label = isActive ? 'Suspender' : 'Reactivar';
      const btnClass = isActive ? 'btn-outline-warning' : 'btn-outline-success';
      return `<form method="post" action="/Admin/Licenses/Index?handler=Toggle&licenseId=${row.id}">
                <input type="hidden" name="__RequestVerificationToken" value="${csrfToken}" />
                <button type="submit" class="btn btn-sm ${btnClass}">${label}</button>
              </form>`;
    };

    const table = new Tabulator('#licenses-table', {
      data: data,
      locale: 'es',
      langs: window.gvrTabulatorLocale,
      layout: 'fitColumns',
      responsiveLayout: 'collapse',
      pagination: true,
      paginationSize: 10,
      paginationSizeSelector: [10, 25, 50, 100],
      paginationCounter: 'rows',
      placeholder: 'Sin licencias todavía',
      columns: [
        { formatter: 'responsiveCollapse', width: 30, minWidth: 30, hozAlign: 'center', headerSort: false, resizable: false },
        { title: 'Key', field: 'key', minWidth: 170, formatter: (cell) => `<code>${cell.getValue()}</code>`, responsive: 0 },
        { title: 'Cliente', field: 'customerName', minWidth: 140, responsive: 1 },
        { title: 'Estado', field: 'status', formatter: statusBadge, width: 120, hozAlign: 'center', responsive: 2 },
        { title: '', field: 'id', formatter: actionButton, width: 140, hozAlign: 'center', headerSort: false, responsive: 3 },
        { title: 'Plan', field: 'planCode', width: 100, responsive: 4 },
        { title: 'Vence', field: 'validUntil', width: 120, sorter: 'date', formatter: (cell) => cell.getValue()?.slice(0, 10), responsive: 5 },
        { title: 'Devices', field: 'deviceCount', width: 100, hozAlign: 'center', formatter: (cell) => `${cell.getValue()} / ${cell.getData().maxDevices}`, responsive: 6 },
      ],
    });

    document.getElementById('licenses-filter').addEventListener('input', (e) => {
      const value = e.target.value;
      if (value) {
        table.setFilter([[
          { field: 'key', type: 'like', value },
          { field: 'customerName', type: 'like', value },
          { field: 'planCode', type: 'like', value },
        ]]);
      } else {
        table.clearFilter();
      }
    });
  });
</script>
