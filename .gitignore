*.exe

# Secretos locales del License API (server/) -- connection strings y claves reales nunca se
# versionan; en EasyPanel viven como variables de entorno (docs/LICENSING_PLAN.md, Pieza 6 "Secrets")
server/**/appsettings.*.json
!server/**/appsettings.json
server/.env
server/**/*.pfx
server/**/*.pem
server/.build-check/
src/.build-check/

# Certificados Authenticode locales (nunca versionar PFX/contraseñas)
certs/
