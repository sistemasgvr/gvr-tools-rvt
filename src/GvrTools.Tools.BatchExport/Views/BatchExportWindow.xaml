<Window x:Class="GvrTools.Tools.BatchExport.Views.BatchExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GVR Tools · Exportación masiva de láminas"
        Height="850" Width="900" MinHeight="640" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/GvrTools.UI;component/Theme/GvrTheme.xaml"/>
    </Window.Resources>

    <Grid Margin="{StaticResource Gvr.Padding.Window}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0 header -->
            <RowDefinition Height="Auto"/>   <!-- 1 step tabs -->
            <RowDefinition Height="*"/>      <!-- 2 step content -->
            <RowDefinition Height="Auto"/>   <!-- 3 footer -->
        </Grid.RowDefinitions>

        <!-- Header: GVR shield + tool name + document + strategy hint + Cambiar plan CTA
             (UI_FREEMIUM_PLAN.md §3.2, "Unlock Premium" equivalent). -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" x:Name="HeaderIcon" Width="42" Height="42"
                   Margin="0,0,12,0" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Exportación masiva de láminas" Style="{StaticResource Gvr.Text.Title}"/>
                    <TextBlock Text="{Binding DocumentTitle, StringFormat=' · {0}'}"
                               Style="{StaticResource Gvr.Text.Title}"
                               Foreground="{StaticResource Gvr.Brush.Muted}"/>
                </StackPanel>
                <TextBlock Text="{Binding StrategyDescription}" Style="{StaticResource Gvr.Text.Subtle}"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <Button Grid.Column="2" Content="Cambiar plan" Style="{StaticResource Gvr.Button.Upgrade}"
                    Command="{Binding ChangePlanCommand}" VerticalAlignment="Center"
                    ToolTip="Ver tu plan actual, activar una clave de licencia o desactivar este PC."/>
        </Grid>

        <!-- Step tabs clicables (estilo ProSheets: pastillas con fondo activo). -->
        <Border Grid.Row="1" Background="{StaticResource Gvr.Brush.Surface}"
                BorderBrush="{StaticResource Gvr.Brush.Line}" BorderThickness="1" CornerRadius="4"
                Padding="6,4" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="Selección" Command="{Binding GoToStepCommand}" CommandParameter="1">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Gvr.WizardTab}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelectionStep}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Background" Value="{StaticResource Gvr.Brush.Accent}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Gvr.Brush.Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Formato" Command="{Binding GoToStepCommand}" CommandParameter="2">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Gvr.WizardTab}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFormatStep}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Background" Value="{StaticResource Gvr.Brush.Accent}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Gvr.Brush.Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Crear" Command="{Binding GoToStepCommand}" CommandParameter="3">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Gvr.WizardTab}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCreateStep}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Background" Value="{StaticResource Gvr.Brush.Accent}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Gvr.Brush.Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- Step content: los tres paneles ocupan la misma celda, solo uno es visible a la vez.
             Ningún binding ni comando de los controles internos cambió respecto a la versión de
             una sola página; solo se agruparon bajo Visibility por paso. -->
        <Grid Grid.Row="2">

            <!-- Paso 1: Selección -->
            <Grid Visibility="{Binding IsSelectionStep, Converter={StaticResource Gvr.BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- sheets/views toggle -->
                    <RowDefinition Height="Auto"/>   <!-- toolbar -->
                    <RowDefinition Height="Auto"/>   <!-- saved filter row -->
                    <RowDefinition Height="*"/>      <!-- grid -->
                </Grid.RowDefinitions>

                <!-- Qué se exporta: láminas (comportamiento habitual) o vistas independientes. -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10"
                            IsEnabled="{Binding CanEditOptions}">
                    <TextBlock Text="Mostrar:" Style="{StaticResource Gvr.Text.Label}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <RadioButton GroupName="GvrItemKind" Content="Láminas" VerticalAlignment="Center"
                                 Foreground="{StaticResource Gvr.Brush.Ink}" Margin="0,0,16,0"
                                 IsChecked="{Binding IsSheetsMode}"
                                 ToolTip="Exportar láminas del proyecto (comportamiento habitual)."/>
                    <RadioButton GroupName="GvrItemKind" Content="Vistas" VerticalAlignment="Center"
                                 Foreground="{StaticResource Gvr.Brush.Ink}"
                                 IsChecked="{Binding IsViewsMode}"
                                 ToolTip="Exportar vistas independientes (plantas, cortes, 3D, detalle...) en vez de láminas."/>
                </StackPanel>

                <!-- Selection toolbar. Search is always visible; the Set filter only appears when the
                     project actually has saved sheet sets. -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Todas" Style="{StaticResource Gvr.Button}"
                            Command="{Binding SelectAllCommand}"
                            ToolTip="Marca todas las láminas que ahora mismo se ven en la lista (respetando el buscador y el filtro por set)."/>
                    <Button Grid.Column="1" Content="Ninguna" Style="{StaticResource Gvr.Button}"
                            Command="{Binding SelectNoneCommand}"
                            ToolTip="Desmarca las láminas visibles en la lista."/>
                    <Button Grid.Column="2" Content="Invertir" Style="{StaticResource Gvr.Button}"
                            Command="{Binding InvertSelectionCommand}"
                            ToolTip="Invierte la selección de las láminas visibles: marca las desmarcadas y desmarca las marcadas."/>
                    <Button Grid.Column="3" Content="Pendientes" Style="{StaticResource Gvr.Button}"
                            Command="{Binding SelectPendingCommand}"
                            ToolTip="Marca solo las láminas visibles que nunca se han exportado desde este PC (desmarca el resto)."/>

                    <TextBlock Grid.Column="5" Text="Buscar:" Style="{StaticResource Gvr.Text.Label}" Margin="12,0,6,0"/>
                    <TextBox Grid.Column="6" Style="{StaticResource Gvr.TextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Filtra la lista por número o por nombre de lámina. No modifica lo que ya está marcado."/>

                    <StackPanel Grid.Column="7" Grid.ColumnSpan="2" Orientation="Horizontal"
                                Visibility="{Binding HasSheetSets, Converter={StaticResource Gvr.BoolToVisibility}}">
                        <TextBlock Text="Set:" Style="{StaticResource Gvr.Text.Label}" Margin="12,0,6,0"/>
                        <ComboBox MinWidth="190" Style="{StaticResource Gvr.ComboBox}"
                                  ItemsSource="{Binding SheetSetNames}" SelectedItem="{Binding SelectedSheetSet}"
                                  ToolTip="Filtra las láminas por un set guardado en el proyecto (los mismos sets que aparecen en el diálogo Imprimir de Revit)."/>
                    </StackPanel>
                </Grid>

                <!-- Filtros guardados: marcar un subconjunto una vez y reusarlo después sin volver
                     a marcar casilla por casilla ("checklist por especialidad"). -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Filtro:" Style="{StaticResource Gvr.Text.Label}" Margin="0,0,6,0"
                               VerticalAlignment="Center"/>
                    <ComboBox MinWidth="190" Style="{StaticResource Gvr.ComboBox}"
                              ItemsSource="{Binding SavedSelectionNames}" SelectedItem="{Binding SelectedSavedSelectionName}"
                              ToolTip="Elige un filtro guardado para mostrar y marcar solo esas láminas/vistas. '(Todos)' quita el filtro y vuelve a mostrar todo."/>
                    <Button Content="Eliminar" Style="{StaticResource Gvr.Button}" Margin="6,0,0,0"
                            Command="{Binding DeleteSavedSelectionCommand}"
                            Visibility="{Binding IsRealSavedSelectionActive, Converter={StaticResource Gvr.BoolToVisibility}}"
                            ToolTip="Elimina el filtro elegido."/>
                    <Button Content="Guardar selección como filtro..." Style="{StaticResource Gvr.Button}" Margin="12,0,0,0"
                            Command="{Binding SaveSelectionCommand}"
                            ToolTip="Guarda las láminas/vistas marcadas ahora mismo con un nombre, para volver a marcarlas después con un clic."/>
                </StackPanel>

                <!-- Sheet grid + count summary -->
                <DockPanel Grid.Row="3">
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding SelectionSummary}"
                               Style="{StaticResource Gvr.Text.Subtle}"
                               HorizontalAlignment="Right" Margin="0,4,2,0"/>

                    <DataGrid Style="{StaticResource Gvr.DataGrid}" ItemsSource="{Binding SheetsView}"
                              CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <!-- Select-all en el encabezado (como ProSheets). -->
                            <DataGridTemplateColumn Width="36" CanUserResize="False">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="2"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.Header>
                                    <CheckBox IsThreeState="True"
                                              ToolTip="Seleccionar / deseleccionar todas las láminas visibles"
                                              IsChecked="{Binding DataContext.AreAllVisibleSelected, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="N° lámina" Binding="{Binding Number}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding ViewTypeLabel}" Width="110" IsReadOnly="True"
                                                 ToolTipService.ToolTip="Tipo de vista (solo en modo Vistas)."/>
                            <DataGridTextColumn Header="Rev." Binding="{Binding RevisionNumber}" Width="60" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Descripción de revisión" Binding="{Binding RevisionDescription}" Width="210" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Exportación" Binding="{Binding ExportStatusLabel}" Width="160" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WasExported}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource Gvr.Brush.Muted}"/>
                                                <Setter Property="FontStyle" Value="Italic"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>

            <!-- Paso 2: Formato. Todas las opciones visibles; las no incluidas van con candado
                 y al clic abren Cambiar plan (UI_FREEMIUM_PLAN.md §3.1). -->
            <ScrollViewer Visibility="{Binding IsFormatStep, Converter={StaticResource Gvr.BoolToVisibility}}"
                          VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource Gvr.Card}" IsEnabled="{Binding CanEditOptions}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Formato:" Style="{StaticResource Gvr.Text.Label}" VerticalAlignment="Center"/>
                            <ItemsControl ItemsSource="{Binding FormatOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectFormatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Formato de salida. Si está bloqueado, abre Cambiar plan.">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource Gvr.Icon.Lock}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Margin="0,0,5,0" Width="11" Height="11">
                                                    <Path.Style>
                                                        <Style TargetType="Path" BasedOn="{StaticResource Gvr.IconPath}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Gvr.FormatOption}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource Gvr.Brush.Accent}"/>
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Gvr.Brush.Accent}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Gvr.Brush.Muted}"/>
                                                            <Setter Property="Opacity" Value="0.85"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <CheckBox Content="Abrir la carpeta al finalizar" Style="{StaticResource Gvr.CheckBox}"
                                      Margin="12,0,0,0" IsChecked="{Binding OpenFolderWhenDone}"
                                      VerticalAlignment="Center"
                                      ToolTip="Cuando termine la exportación, abre el explorador de Windows en la carpeta destino."/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Gvr.Text.Subtle}" Margin="0,4,0,0"
                                   Visibility="{Binding HasBlockedFormats, Converter={StaticResource Gvr.BoolToVisibility}}">
                            <Run Text="Las opciones con"/>
                            <InlineUIContainer>
                                <Path Style="{StaticResource Gvr.IconPath}" Data="{StaticResource Gvr.Icon.Lock}"
                                      Fill="{StaticResource Gvr.Brush.Muted}" Width="11" Height="11"
                                      Margin="3,0,3,-1"/>
                            </InlineUIContainer>
                            <Run Text="no están en tu plan. Clic en ellas para Cambiar plan."/>
                        </TextBlock>

                        <!-- PDF options: 3 columnas agrupadas por tema (estilo ProSheets Format tab), en vez
                             de una sola lista vertical: Ubicación/Zoom | Líneas ocultas/Apariencia | Opciones/Archivo. -->
                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding ShowPdfOptions, Converter={StaticResource Gvr.BoolToVisibility}}">
                            <TextBlock Text="Opciones de PDF" Style="{StaticResource Gvr.Text.Subtle}"
                                       FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <StackPanel Margin="0,0,0,8"
                                        Visibility="{Binding ShowPrinterSelector, Converter={StaticResource Gvr.BoolToVisibility}}"
                                        ToolTip="Revit 2021 no tiene exportador de PDF propio, así que se plotea con PDF24 Toolbox, la única impresora que este complemento usa para exportación masiva.">
                                <TextBlock Text="{Binding PrinterHint}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Gvr.Text.Subtle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPdfPrinterMissing}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Gvr.Brush.Danger}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Columna 1: Ubicación en el papel + Zoom -->
                                <Border Grid.Column="0" Style="{StaticResource Gvr.Card}" Margin="0,0,6,0" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="Ubicación en el papel" Style="{StaticResource Gvr.Text.Subtle}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <CheckBox Content="Usar el tamaño de cada lámina" Style="{StaticResource Gvr.CheckBox}"
                                                  IsChecked="{Binding PdfMatchSheetSize}" Margin="0,0,0,10"
                                                  ToolTip="Cada PDF sale en el tamaño de papel real de la lámina (según su rótulo), en vez de forzar un tamaño único para todas."/>

                                        <RadioButton GroupName="GvrPdfPlacement" Content="Centrado" Foreground="{StaticResource Gvr.Brush.Ink}"
                                                     IsChecked="{Binding IsPdfPaperPlacementCenter}" Margin="0,0,0,6"
                                                     ToolTip="Centra el dibujo en la hoja."/>
                                        <RadioButton GroupName="GvrPdfPlacement" Content="Desde una esquina" Foreground="{StaticResource Gvr.Brush.Ink}"
                                                     IsChecked="{Binding IsPdfPaperPlacementOffsetFromCorner}" Margin="0,0,0,6"
                                                     ToolTip="Ancla el dibujo a una esquina. El sub-modo de abajo decide cómo."/>

                                        <!-- Sub-modo de "Desde una esquina": Sin margen/Límite de impresora/Definido por el
                                             usuario, igual que ProSheets; el campo X/Y solo aplica al último. -->
                                        <StackPanel Margin="20,0,0,0"
                                                    Visibility="{Binding ShowPdfCornerMarginMode, Converter={StaticResource Gvr.BoolToVisibility}}">
                                            <RadioButton GroupName="GvrPdfCornerMode" Content="Sin margen" Foreground="{StaticResource Gvr.Brush.Ink}"
                                                         IsChecked="{Binding IsPdfCornerMarginNoMargin}" Margin="0,0,0,6"
                                                         ToolTip="El dibujo queda al ras de la esquina, sin desplazamiento."/>
                                            <RadioButton GroupName="GvrPdfCornerMode" Content="Límite de impresora" Foreground="{StaticResource Gvr.Brush.Ink}"
                                                         IsChecked="{Binding IsPdfCornerMarginPrinterLimit}" Margin="0,0,0,6"
                                                         ToolTip="Respeta el margen mínimo que declara la impresora."/>
                                            <RadioButton GroupName="GvrPdfCornerMode" Content="Definido por el usuario" Foreground="{StaticResource Gvr.Brush.Ink}"
                                                         IsChecked="{Binding IsPdfCornerMarginUserDefined}" Margin="0,0,0,6"
                                                         ToolTip="Desplazamiento manual con los valores X/Y de abajo."/>
                                            <StackPanel Orientation="Horizontal" Margin="20,0,0,10"
                                                        Visibility="{Binding ShowPdfOffsetFields, Converter={StaticResource Gvr.BoolToVisibility}}">
                                                <TextBlock Text="X:" Style="{StaticResource Gvr.Text.Label}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBox Width="52" Style="{StaticResource Gvr.TextBox}"
                                                         Text="{Binding PdfOffsetXInches, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Desplazamiento horizontal desde la esquina, en pulgadas."/>
                                                <TextBlock Text="Y:" Style="{StaticResource Gvr.Text.Label}" Margin="8,0,4,0" VerticalAlignment="Center"/>
                                                <TextBox Width="52" Style="{StaticResource Gvr.TextBox}"
                                                         Text="{Binding PdfOffsetYInches, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Desplazamiento vertical desde la esquina, en pulgadas."/>
                                                <TextBlock Text="pulg." Style="{StaticResource Gvr.Text.Subtle}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Text="Zoom" Style="{StaticResource Gvr.Text.Subtle}" FontWeight="SemiBold" Margin="0,8,0,8"/>
                                        <RadioButton GroupName="GvrPdfZoom" Content="Ajustar a la página" Foreground="{StaticResource Gvr.Brush.Ink}"
                                                     IsChecked="{Binding PdfFitToPage}" Margin="0,0,0,6"
                                                     ToolTip="Ajusta el dibujo al tamaño del papel."/>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton GroupName="GvrPdfZoom" Content="Zoom:" Foreground="{StaticResource Gvr.Brush.Ink}"
                                                         IsChecked="{Binding PdfFitToPage, Converter={StaticResource Gvr.InverseBool}}" VerticalAlignment="Center"
                                                         ToolTip="Plotea a la escala indicada (el dibujo puede quedar cortado si el papel es más chico)."/>
                                            <TextBox Width="52" Style="{StaticResource Gvr.TextBox}" Margin="6,0,0,0"
                                                     Text="{Binding PdfZoomPercentage, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding PdfFitToPage, Converter={StaticResource Gvr.InverseBool}}"
                                                     ToolTip="Escala de ploteo en %. 100 = tamaño real."/>
                                            <TextBlock Text="%" Style="{StaticResource Gvr.Text.Label}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Columna 2: Líneas ocultas + Apariencia -->
                                <Border Grid.Column="1" Style="{StaticResource Gvr.Card}" Margin="6,0,6,0" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="Líneas ocultas" Style="{StaticResource Gvr.Text.Subtle}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <RadioButton GroupName="GvrPdfHiddenLine" Content="Procesamiento vectorial" Foreground="{StaticResource Gvr.Brush.Ink}"
                                                     IsChecked="{Binding PdfProcessAsRaster, Converter={StaticResource Gvr.InverseBool}}" Margin="0,0,0,6"
                                                     ToolTip="Por defecto: resuelve más rápido y con más nitidez."/>
                                        <RadioButton GroupName="GvrPdfHiddenLine" Content="Procesamiento raster" Foreground="{StaticResource Gvr.Brush.Ink}"
                                                     IsChecked="{Binding PdfProcessAsRaster}" Margin="0,0,0,14"
                                                     ToolTip="Actívalo solo si ves artefactos en geometría muy compleja."/>

                                        <TextBlock Text="Apariencia" Style="{StaticResource Gvr.Text.Subtle}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <TextBlock Text="Calidad ráster" Style="{StaticResource Gvr.Text.Label}" Margin="0,0,0,4"/>
                                        <ComboBox Style="{StaticResource Gvr.ComboBox}" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding PdfRasterQualities}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding PdfRasterQuality}"
                                                  ToolTip="Resolución con la que se rasterizan las imágenes y sombreados en el PDF."/>
                                        <TextBlock Text="Color" Style="{StaticResource Gvr.Text.Label}" Margin="0,0,0,4"/>
                                        <ComboBox Style="{StaticResource Gvr.ComboBox}" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding PdfColorModes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding PdfColorMode}"
                                                  ToolTip="Color imprime a todo color, Escala de grises convierte a tonos de gris, Blanco y negro imprime todo con líneas negras."/>
                                    </StackPanel>
                                </Border>

                                <!-- Columna 3: Opciones + Archivo -->
                                <Border Grid.Column="2" Style="{StaticResource Gvr.Card}" Margin="6,0,0,0" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="Opciones" Style="{StaticResource Gvr.Text.Subtle}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <CheckBox Content="Vínculos de vista en azul" Style="{StaticResource Gvr.CheckBox}"
                                                  IsChecked="{Binding PdfViewLinksInBlue}" Margin="0,0,0,6"
                                                  ToolTip="Resalta en azul los vínculos de vista (view links) en el PDF."/>
                                        <CheckBox Content="Ocultar planos de referencia/trabajo" Style="{StaticResource Gvr.CheckBox}"
                                                  IsChecked="{Binding PdfHideReferencePlanes}" Margin="0,0,0,6"
                                                  ToolTip="Oculta los planos de referencia y de trabajo en el PDF."/>
                                        <CheckBox Content="Ocultar etiquetas de vista sin referencia" Style="{StaticResource Gvr.CheckBox}"
                                                  IsChecked="{Binding PdfHideUnreferencedViewTags}" Margin="0,0,0,6"
                                                  ToolTip="Oculta las etiquetas de vista (view tags) que no apuntan a nada colocado en el proyecto."/>
                                        <CheckBox Content="Ocultar cajas de alcance" Style="{StaticResource Gvr.CheckBox}"
                                                  IsChecked="{Binding PdfHideScopeBoxes}" Margin="0,0,0,6"
                                                  ToolTip="Oculta las cajas de alcance (scope boxes) en el PDF."/>
                                        <CheckBox Content="Ocultar límites de recorte" Style="{StaticResource Gvr.CheckBox}"
                                                  IsChecked="{Binding PdfHideCropBoundaries}" Margin="0,0,0,6"
                                                  ToolTip="Oculta el recuadro de recorte (crop boundary) de cada vista en el PDF."/>
                                        <CheckBox Content="Reemplazar medio tono con líneas finas" Style="{StaticResource Gvr.CheckBox}"
                                                  IsChecked="{Binding PdfReplaceHalftoneWithThinLines}" Margin="0,0,0,6"
                                                  ToolTip="Útil si el PDF se va a imprimir o fotocopiar en blanco y negro."/>
                                        <CheckBox Content="Enmascarar líneas coincidentes en bordes" Style="{StaticResource Gvr.CheckBox}"
                                                  IsChecked="{Binding PdfMaskCoincidentLines}" Margin="0,0,0,14"
                                                  ToolTip="En los bordes de una región recortada, oculta líneas que coinciden exactamente con el borde del recorte."/>

                                        <StackPanel Visibility="{Binding CanCombinePdf, Converter={StaticResource Gvr.BoolToVisibility}}">
                                            <TextBlock Text="Archivo" Style="{StaticResource Gvr.Text.Subtle}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <RadioButton GroupName="GvrPdfFile" Content="Crear archivos separados" Foreground="{StaticResource Gvr.Brush.Ink}"
                                                         IsChecked="{Binding PdfCombineIntoSingleFile, Converter={StaticResource Gvr.InverseBool}}" Margin="0,0,0,6"
                                                         ToolTip="Un PDF por cada lámina/vista seleccionada (comportamiento habitual)."/>
                                            <RadioButton GroupName="GvrPdfFile" Content="Combinar en un solo archivo" Foreground="{StaticResource Gvr.Brush.Ink}"
                                                         IsChecked="{Binding PdfCombineIntoSingleFile}" Margin="0,0,0,6"
                                                         ToolTip="Escribe todas las láminas/vistas seleccionadas en un único PDF (una sola llamada a Revit)."/>
                                            <StackPanel Visibility="{Binding ShowPdfCombinedFileName, Converter={StaticResource Gvr.BoolToVisibility}}">
                                                <TextBlock Text="Nombre del archivo" Style="{StaticResource Gvr.Text.Label}" Margin="0,0,0,4"/>
                                                <TextBox Style="{StaticResource Gvr.TextBox}" HorizontalAlignment="Stretch"
                                                         Text="{Binding PdfCombinedFileName, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Nombre del PDF combinado. Acepta los mismos tokens de proyecto que el patrón de láminas: {ProjectTitle} {ProjectNumber} {ProjectName} {ClientName} {Date}."/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- DWG options -->
                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding ShowDwgOptions, Converter={StaticResource Gvr.BoolToVisibility}}">
                            <TextBlock Text="Opciones de DWG" Style="{StaticResource Gvr.Text.Subtle}"
                                       FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Configuración:" Style="{StaticResource Gvr.Text.Label}"/>
                                <ComboBox MinWidth="220" Style="{StaticResource Gvr.ComboBox}"
                                          ItemsSource="{Binding DwgSavedSetupChoices}"
                                          SelectedItem="{Binding DwgSavedSetupName}"
                                          ToolTip="Si tu proyecto ya tiene una configuración de exportación DWG guardada (Administrar → Configuraciones DWG/DXF), puedes usarla tal cual -- incluye mapeo de capas y grosores que este panel no cubre. '(Personalizada)' usa los controles de abajo."/>
                            </StackPanel>
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Gvr.Text.Subtle}"
                                       Text="{Binding DwgActiveSetupHint}"
                                       Visibility="{Binding HasDwgActiveSetupHint, Converter={StaticResource Gvr.BoolToVisibility}}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" IsEnabled="{Binding IsUsingCustomDwgOptions}">
                                <TextBlock Text="Versión DWG:" Style="{StaticResource Gvr.Text.Label}"/>
                                <ComboBox MinWidth="170" Style="{StaticResource Gvr.ComboBox}"
                                          ItemsSource="{Binding DwgFileVersions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding DwgFileVersion}"
                                          ToolTip="Formato interno del DWG. AutoCAD abre versiones más nuevas que la propia, pero no al revés: elige la versión más antigua que necesites por compatibilidad."/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <CheckBox Content="Combinar vistas" Style="{StaticResource Gvr.CheckBox}"
                                          IsChecked="{Binding DwgMergeViews}" IsEnabled="{Binding IsUsingCustomDwgOptions}"
                                          ToolTip="Une todas las vistas de la lámina en un único espacio modelo del DWG. Si se desmarca, cada vista queda en su propio 'espacio papel' y hay que moverse entre ellas en AutoCAD."/>
                                <CheckBox Content="Coordenadas compartidas" Style="{StaticResource Gvr.CheckBox}"
                                          IsChecked="{Binding DwgSharedCoordinates}" IsEnabled="{Binding IsUsingCustomDwgOptions}"
                                          ToolTip="Usa el sistema de coordenadas compartido del proyecto (típicamente el sistema topográfico) en vez de las coordenadas internas de Revit. Actívalo si el DWG se va a georreferenciar con otros planos."/>
                                <CheckBox Content="Exportar imágenes" Style="{StaticResource Gvr.CheckBox}"
                                          IsChecked="{Binding DwgAlsoExportImage}"
                                          ToolTip="Además del DWG, genera un PNG por lámina (mismo nombre, extensión .png) junto al DWG. Útil como vista previa o para adjuntar imágenes; duplica la cantidad de archivos."/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- Paso 3: Crear — progreso visible + grid de láminas con estado por fila. -->
            <Grid Visibility="{Binding IsCreateStep, Converter={StaticResource Gvr.BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- progress banner -->
                    <RowDefinition Height="Auto"/>   <!-- destination -->
                    <RowDefinition Height="Auto"/>   <!-- naming -->
                    <RowDefinition Height="*"/>      <!-- sheet progress grid -->
                    <RowDefinition Height="Auto"/>   <!-- open folder / cancel -->
                </Grid.RowDefinitions>

                <!-- Banner de progreso + cuota (siempre visible, como ProSheets). -->
                <Border Grid.Row="0" Style="{StaticResource Gvr.Card}" Margin="0,0,0,10" Padding="12,10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ProgressPercentText}"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ProgressFractionText}"
                                       Style="{StaticResource Gvr.Text.Subtle}" VerticalAlignment="Center"/>
                        </Grid>
                        <ProgressBar Height="14" Minimum="0" Margin="0,8,0,0"
                                     Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue, Mode=OneWay}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{Binding QuotaFooterText}" Style="{StaticResource Gvr.Text.Subtle}"
                                       VerticalAlignment="Center"/>
                            <Button Content="{Binding UpgradeHintText}" Style="{StaticResource Gvr.Button.Upgrade}"
                                    Padding="8,2" MinWidth="0" Margin="12,0,0,0"
                                    Command="{Binding ChangePlanCommand}"
                                    Visibility="{Binding ShowUpgradeHint, Converter={StaticResource Gvr.BoolToVisibility}}"
                                    ToolTip="Abre Cambiar plan para subir a Starter/Pro."/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Gvr.Text.Subtle}"
                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Destination folder. -->
                <Grid Grid.Row="1" IsEnabled="{Binding CanEditOptions}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Carpeta destino:" Style="{StaticResource Gvr.Text.Label}"
                               ToolTip="Se crea automáticamente una subcarpeta con el nombre del proyecto, y ahí caen los archivos exportados."/>
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Gvr.TextBox}"
                             Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Ruta donde se guardarán los archivos. Se puede escribir o pegar directamente, o elegir con Examinar."/>
                    <Button Grid.Row="0" Grid.Column="2" Content="Examinar..." Style="{StaticResource Gvr.Button}"
                            Margin="8,0,0,0" Command="{Binding BrowseFolderCommand}"
                            ToolTip="Abre el explorador de carpetas para elegir la carpeta destino."/>

                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3,0,0"
                               Style="{StaticResource Gvr.Text.Subtle}"
                               Text="{Binding DestinationFolder, StringFormat='Se creará: {0}'}"/>
                </Grid>

                <!-- Naming pattern -->
                <Border Grid.Row="2" Style="{StaticResource Gvr.Card}" Margin="0,10,0,0" IsEnabled="{Binding CanEditOptions}">
                    <StackPanel>
                        <TextBlock Text="Nomenclatura de archivos" Style="{StaticResource Gvr.Text.Subtle}"
                                   FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Plantilla:" Style="{StaticResource Gvr.Text.Label}"/>
                            <ComboBox MinWidth="200" Style="{StaticResource Gvr.ComboBox}"
                                      ItemsSource="{Binding NamingPresetChoices}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedNamingPreset}"
                                      ToolTip="Convenciones comunes para partir -- elegir una solo llena el patrón de abajo, que sigue siendo editable a mano."/>

                            <TextBlock Text="Patrón:" Style="{StaticResource Gvr.Text.Label}" Margin="18,0,8,0"/>
                            <TextBox MinWidth="240" Style="{StaticResource Gvr.TextBox}"
                                     Text="{Binding NamingPattern, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{Binding NamingHelpText, StringFormat='Códigos disponibles: {0}'}"/>
                        </StackPanel>
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource Gvr.Text.Subtle}"
                                   Text="{Binding NamingPreview, StringFormat='Ejemplo: {0}'}"/>
                    </StackPanel>
                </Border>

                <!-- Grid de láminas con select-all + progreso por fila. -->
                <DockPanel Grid.Row="3" Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Gvr.Text.Subtle}" Margin="0,0,0,6"
                               Text="Láminas del lote — puedes ajustar la selección antes de exportar. La columna Progreso se actualiza en vivo."/>
                    <DataGrid Style="{StaticResource Gvr.DataGrid}" ItemsSource="{Binding SheetsView}"
                              IsReadOnly="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="36" CanUserResize="False">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.Header>
                                    <CheckBox IsThreeState="True"
                                              IsEnabled="{Binding DataContext.CanEditOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              ToolTip="Seleccionar / deseleccionar todas las láminas visibles"
                                              IsChecked="{Binding DataContext.AreAllVisibleSelected, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsEnabled="{Binding DataContext.CanEditOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="N° lámina" Binding="{Binding Number}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Formato" Width="90" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{Binding DataContext.SelectedFormatLabel, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Progreso" Width="140" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RunProgressLabel}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Gvr.Brush.Muted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RunProgressLabel}" Value="OK">
                                                            <Setter Property="Foreground" Value="{StaticResource Gvr.Brush.Success}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RunProgressLabel}" Value="PDF+DWG OK">
                                                            <Setter Property="Foreground" Value="{StaticResource Gvr.Brush.Success}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RunProgressLabel}" Value="Error">
                                                            <Setter Property="Foreground" Value="{StaticResource Gvr.Brush.Danger}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RunProgressLabel}" Value="Exportando…">
                                                            <Setter Property="Foreground" Value="{StaticResource Gvr.Brush.Accent}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                        <Setter Property="Opacity" Value="0.45"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </DockPanel>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Abrir carpeta" Style="{StaticResource Gvr.Button.Action}"
                            Command="{Binding OpenFolderCommand}"
                            ToolTip="Abre el explorador de Windows en la carpeta destino."/>
                    <Button Content="Cancelar exportación" Style="{StaticResource Gvr.Button.Action}"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding IsExporting, Converter={StaticResource Gvr.BoolToVisibility}}"
                            ToolTip="Detiene la exportación al terminar la lámina actual (no rompe el archivo en curso)."/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Footer: resumen de cuota + navegación (UI_FREEMIUM_PLAN.md §3.1/§3.3). -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Gvr.Text.Subtle}" Text="{Binding SelectionSummary}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Gvr.Text.Subtle}" Text="{Binding QuotaFooterText}"/>
                    <Button Content="Cambiar plan" Style="{StaticResource Gvr.Button}" Padding="6,1" MinWidth="0"
                            Margin="8,0,0,0" Command="{Binding ChangePlanCommand}"
                            Visibility="{Binding HasQuotaFooterText, Converter={StaticResource Gvr.BoolToVisibility}}"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Gvr.Text.Subtle}" Foreground="{StaticResource Gvr.Brush.Danger}"
                           Text="{Binding QuotaNearLimitHint}" Margin="0,2,0,0"
                           Visibility="{Binding ShowQuotaNearLimitHint, Converter={StaticResource Gvr.BoolToVisibility}}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Atrás" Style="{StaticResource Gvr.Button.Action}"
                        Command="{Binding GoBackCommand}"
                        Visibility="{Binding CanGoBack, Converter={StaticResource Gvr.BoolToVisibility}}"/>
                <Button Content="Siguiente" Style="{StaticResource Gvr.Button.Primary}"
                        Command="{Binding GoNextCommand}"
                        Visibility="{Binding ShowNextButton, Converter={StaticResource Gvr.BoolToVisibility}}"/>
                <Button Content="{Binding ExportButtonLabel}" Style="{StaticResource Gvr.Button.Primary}"
                        Command="{Binding ExportCommand}"
                        Visibility="{Binding IsCreateStep, Converter={StaticResource Gvr.BoolToVisibility}}"
                        ToolTip="Inicia la exportación de las láminas marcadas."/>
                <Button Content="Cerrar" Style="{StaticResource Gvr.Button.Action}" Click="OnCloseClick"
                        ToolTip="Cierra la ventana. Si hay una exportación en curso se cancela primero."/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
