<Window x:Class="GvrTools.Licensing.Activation.AccountLicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GVR Tools · Cambiar plan"
        Height="520" Width="540" MinHeight="460" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/GvrTools.UI;component/Theme/GvrTheme.xaml"/>
    </Window.Resources>

    <Grid Margin="{StaticResource Gvr.Padding.Window}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" x:Name="HeaderIcon" Width="32" Height="32"
                   Margin="0,0,10,0" VerticalAlignment="Top"/>

            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding StatusHeadline}" Style="{StaticResource Gvr.Text.Title}"/>
                <TextBlock Text="{Binding PlanSummary}" Style="{StaticResource Gvr.Text.Subtle}" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding GraceSummary}" Style="{StaticResource Gvr.Text.Subtle}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding QuotaSummary}" Style="{StaticResource Gvr.Text.Subtle}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding SupportHint}" Style="{StaticResource Gvr.Text.Subtle}" Margin="0,10,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Clave de licencia" Style="{StaticResource Gvr.Text.Label}" Margin="0,0,0,4"/>
            <TextBox Style="{StaticResource Gvr.TextBox}" Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12"
                     ToolTip="Pega la clave Starter/Pro que te envió soporte."/>

            <TextBlock Text="Nombre completo" Style="{StaticResource Gvr.Text.Label}" Margin="0,0,0,4"/>
            <TextBox Style="{StaticResource Gvr.TextBox}" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12"/>

            <TextBlock Text="Correo" Style="{StaticResource Gvr.Text.Label}" Margin="0,0,0,4"/>
            <TextBox Style="{StaticResource Gvr.TextBox}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,8"/>

            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Gvr.Brush.Danger}"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Conectando…" Margin="0,0,0,8"
                   Foreground="{StaticResource Gvr.Brush.Muted}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Cotizar un plan" Style="{StaticResource Gvr.Button}"
                    Command="{Binding QuoteCommand}"
                    ToolTip="Abre la página de cotización en tu navegador -- para pedir una licencia nueva o subir de plan."/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Desactivar este PC" Style="{StaticResource Gvr.Button}"
                        Command="{Binding DeactivateCommand}"
                        Visibility="{Binding ShowDeactivate, Converter={StaticResource Gvr.BoolToVisibility}}"/>
                <Button Content="Cerrar" Style="{StaticResource Gvr.Button}" Command="{Binding CloseCommand}"/>
                <Button Content="Activar" Style="{StaticResource Gvr.Button.Primary}" Command="{Binding ActivateCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
