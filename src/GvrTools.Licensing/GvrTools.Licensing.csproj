<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cliente de licenciamiento (docs/LICENSING_PLAN.md, Pieza 2). Referenciado por GvrTools.App y por
    las tools que necesiten consultar entitlements/cuota. Revit-free a propósito, igual que
    GvrTools.UI: net48 sirve Revit 2021-2024, net8.0-windows sirve Revit 2025-2026 y
    net10.0-windows sirve Revit 2027+.

    Solo usa HttpClient + System.Security.Cryptography (ECDsa) + System.Text.Json, todos built-in en
    ambos frameworks. Cero NuGet de runtime, misma regla que el resto del add-in (ver
    docs/ARCHITECTURE.md): un crack de licencia no debería empezar por un choque de ensamblados.
  -->

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <AssemblyName>GvrTools.Licensing</AssemblyName>
    <RootNamespace>GvrTools.Licensing</RootNamespace>
    <Description>Activación, entitlements y cuota de GVR Tools contra el License API.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GvrTools.Core\GvrTools.Core.csproj" />
    <ProjectReference Include="..\GvrTools.UI\GvrTools.UI.csproj" />
  </ItemGroup>

  <!-- HttpClient vive en System.Net.Http; en net48 hay que referenciarlo explícitamente.
       No es un NuGet de runtime embebido junto al add-in: es ensamblado del GAC/.NET Framework. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

</Project>
