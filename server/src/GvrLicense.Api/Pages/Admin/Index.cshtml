@page
@model GvrLicense.Api.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row">
    <div class="col-lg-3 col-6">
        <div class="small-box text-bg-success">
            <div class="inner">
                <h3>@Model.ActiveCount</h3>
                <p>Licencias activas</p>
            </div>
            <i class="bi bi-check-circle small-box-icon"></i>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box text-bg-warning">
            <div class="inner">
                <h3>@Model.SuspendedCount</h3>
                <p>Suspendidas</p>
            </div>
            <i class="bi bi-pause-circle small-box-icon"></i>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box text-bg-danger">
            <div class="inner">
                <h3>@Model.ExpiringSoonCount</h3>
                <p>Vencen en 30 días</p>
            </div>
            <i class="bi bi-hourglass-split small-box-icon"></i>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box text-bg-primary">
            <div class="inner">
                <h3>@Model.CustomerCount</h3>
                <p>Clientes</p>
            </div>
            <i class="bi bi-people small-box-icon"></i>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">Licencias recientes</h3>
        <a href="/Admin/Licenses/Index" class="btn btn-outline-secondary btn-sm">Ver todas <i class="bi bi-arrow-right"></i></a>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr>
                    <th>Key</th>
                    <th>Cliente</th>
                    <th>Plan</th>
                    <th>Estado</th>
                    <th>Vence</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.RecentRows.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-secondary p-3">Sin licencias todavía -- <a href="/Admin/Customers/Create">crea un cliente</a> para empezar.</td></tr>
            }
            @foreach (var row in Model.RecentRows)
            {
                var badgeClass = row.Status switch
                {
                    GvrLicense.Domain.Entities.LicenseStatus.Active => "text-bg-success",
                    GvrLicense.Domain.Entities.LicenseStatus.Suspended => "text-bg-warning",
                    _ => "text-bg-danger"
                };
                <tr>
                    <td><code>@row.Key</code></td>
                    <td>@row.CustomerName</td>
                    <td>@row.PlanCode</td>
                    <td><span class="badge @badgeClass">@row.Status</span></td>
                    <td>@row.ValidUntil.ToString("yyyy-MM-dd")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
