@page
@model GvrLicense.Api.Pages.Admin.Plans.EditModel
@{
    ViewData["Title"] = "Editar plan";
}

@if (TempData["Saved"] != null)
{
    <div class="alert alert-success">Plan actualizado.</div>
}

<div class="card card-primary" style="max-width: 40rem">
    <div class="card-header"><h3 class="card-title">Editar plan <code>@Model.Code</code></h3></div>
    <form method="post">
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">Nombre visible</label>
                <input asp-for="Input.DisplayName" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Features (una por línea, <code>codigo=valor</code>)</label>
                <textarea asp-for="Input.FeaturesText" class="form-control" rows="12" style="font-family: monospace"></textarea>
                <div class="form-text">Los cambios afectan a todas las licencias con este plan desde el próximo heartbeat -- no hace falta recompilar el add-in.</div>
            </div>
        </div>
        <div class="card-footer d-flex gap-2">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a href="/Admin/Plans/Index" class="btn btn-secondary">Volver</a>
        </div>
    </form>
</div>
