<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The deployable add-in: the assembly Revit's .addin manifest points at. Its only job is to build
    the ribbon out of whatever tools it finds, so it never needs editing when a tool is added.

    Everything the add-in needs lands in build/<RevitVersion>/, which is the folder the .addin
    manifest and scripts/install-addin.ps1 refer to.
  -->

  <Import Project="..\GvrTools.Revit.props" />

  <PropertyGroup>
    <AssemblyName>GvrTools.App</AssemblyName>
    <RootNamespace>GvrTools.App</RootNamespace>
    <!-- The whole add-in lands in one flat folder per Revit release. Only this project flattens its
         output: the multi-targeted libraries must keep their per-framework subfolders, or a net48
         and a net8.0 build of the same library would overwrite each other in bin/. -->
    <OutputPath>$(GvrBuildRoot)$(RevitVersion)\</OutputPath>
    <OutDir>$(OutputPath)</OutDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Description>Complemento GVR Tools para Autodesk Revit: cinta de opciones y registro de herramientas.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GvrTools.Core\GvrTools.Core.csproj" />
    <ProjectReference Include="..\GvrTools.Revit\GvrTools.Revit.csproj" />
    <ProjectReference Include="..\GvrTools.UI\GvrTools.UI.csproj" />

    <!-- Referenced so the tool is deployed next to the host; it is still *discovered* by scanning
         the output folder for GvrTools.Tools.*.dll, so dropping in a tool built elsewhere works
         exactly the same way. -->
    <ProjectReference Include="..\GvrTools.Tools.BatchExport\GvrTools.Tools.BatchExport.csproj" />
  </ItemGroup>

</Project>
