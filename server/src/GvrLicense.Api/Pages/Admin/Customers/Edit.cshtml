@page
@model GvrLicense.Api.Pages.Admin.Customers.EditModel
@{
    ViewData["Title"] = "Editar cliente";
}

@if (TempData["Saved"] != null)
{
    <div class="alert alert-success">Cliente actualizado.</div>
}

<div class="card card-primary" style="max-width: 40rem">
    <div class="card-header"><h3 class="card-title">Editar cliente</h3></div>
    <form method="post">
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">Empresa</label>
                <input asp-for="Input.CompanyName" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Contacto</label>
                <input asp-for="Input.ContactName" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Correo</label>
                <input asp-for="Input.ContactEmail" type="email" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Notas de pago</label>
                <textarea asp-for="Input.PaymentNotes" class="form-control"></textarea>
            </div>
        </div>
        <div class="card-footer d-flex gap-2">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a href="/Admin/Customers/Index" class="btn btn-secondary">Volver</a>
        </div>
    </form>
</div>
