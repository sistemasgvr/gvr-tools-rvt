@page
@using GvrLicense.Domain.Entities
@model GvrLicense.Api.Pages.Admin.Releases.EditModel
@{
    ViewData["Title"] = "Editar release";
}

@if (TempData["Saved"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        Release actualizado correctamente.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="card card-primary card-outline">
    <div class="card-header">
        <h3 class="card-title">Editar release</h3>
    </div>
    <form id="edit-release-form" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div class="card-body">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3" style="max-width: 28rem">
                <label asp-for="Input.Version" class="form-label">Versión</label>
                <input asp-for="Input.Version" type="text" class="form-control"
                       pattern="^v?\d+\.\d+\.\d+(-[0-9A-Za-z.-]+)?$"
                       placeholder="1.0.0" maxlength="64" required />
                <div class="form-text">Formato MAJOR.MINOR.PATCH, por ejemplo 1.0.0 (se permite prefijo v y prerelease).</div>
            </div>

            <div class="mb-3" style="max-width: 28rem">
                <label asp-for="Input.Kind" class="form-label">Tipo</label>
                <select asp-for="Input.Kind" class="form-select">
                    <option value="@ReleaseKinds.Installer">Instalador (.exe) — descarga inicial del cliente</option>
                    <option value="@ReleaseKinds.Update">Update — lo ofrece el add-in en marcha</option>
                </select>
            </div>

            <div class="mb-3" style="max-width: 36rem">
                <label asp-for="ArtifactFile" class="form-label">Reemplazar archivo (opcional)</label>
                <input asp-for="ArtifactFile" type="file" class="form-control" accept=".exe,.zip,.7z"
                       disabled="@(!Model.MinioConfigured)" />
                <div class="form-text">
                    Archivo actual: <strong>@(Model.ExistingFileName ?? "Sin nombre")</strong>.
                    Si no seleccionas otro, se conservará el artefacto existente.
                </div>
                <div id="edit-upload-progress-container" class="progress mt-2 d-none" role="progressbar"
                     aria-label="Progreso de subida" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                    <div id="edit-upload-progress-bar" class="progress-bar progress-bar-striped progress-bar-animated" style="width: 0%">0%</div>
                </div>
                <div id="edit-upload-error" class="text-danger small mt-2 d-none" role="alert"></div>
                @if (!Model.MinioConfigured)
                {
                    <div class="text-warning small mt-1">MinIO no está configurado; puedes editar los demás campos.</div>
                }
            </div>

            <div class="mb-3">
                <label asp-for="Input.Notes" class="form-label">Notas de la versión</label>
                <textarea asp-for="Input.Notes" class="form-control" rows="5" placeholder="Qué hay de nuevo…"></textarea>
            </div>
        </div>
        <div class="card-footer d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary" id="edit-release-submit">
                <i class="bi bi-check-lg me-1" aria-hidden="true"></i> Guardar cambios
            </button>
            <a href="/Admin/Releases" class="btn btn-outline-secondary">Volver a releases</a>
        </div>
    </form>
</div>

<script>
  document.getElementById('edit-release-form')?.addEventListener('submit', (event) => {
    if (!window.XMLHttpRequest || !window.FormData) return;

    const form = event.currentTarget;
    const fileInput = form.querySelector('input[type="file"]');
    const hasFile = fileInput?.files?.length > 0;
    // Solo XHR con barra si hay archivo grande que subir; si no, POST normal.
    if (!hasFile) return;

    event.preventDefault();
    const submit = document.getElementById('edit-release-submit');
    const container = document.getElementById('edit-upload-progress-container');
    const bar = document.getElementById('edit-upload-progress-bar');
    const error = document.getElementById('edit-upload-error');
    const xhr = new XMLHttpRequest();

    submit.disabled = true;
    error.classList.add('d-none');
    error.textContent = '';
    container.classList.remove('d-none');
    bar.classList.add('progress-bar-animated');
    bar.style.width = '0%';
    bar.textContent = '0%';
    container.setAttribute('aria-valuenow', '0');

    xhr.upload.addEventListener('progress', (progressEvent) => {
      if (!progressEvent.lengthComputable) return;
      const percent = Math.min(100, Math.round((progressEvent.loaded / progressEvent.total) * 100));
      bar.style.width = `${percent}%`;
      bar.textContent = `${percent}%`;
      container.setAttribute('aria-valuenow', percent.toString());
    });

    xhr.addEventListener('load', () => {
      if (xhr.status >= 200 && xhr.status < 300) {
        let redirect = window.location.href;
        try {
          redirect = JSON.parse(xhr.responseText).redirect || redirect;
        } catch {
          redirect = xhr.responseURL || redirect;
        }
        window.location.assign(redirect);
        return;
      }

      let message = 'No se pudo actualizar el release.';
      try {
        message = JSON.parse(xhr.responseText).message || message;
      } catch { }
      error.textContent = message;
      error.classList.remove('d-none');
      submit.disabled = false;
      bar.classList.remove('progress-bar-animated');
    });

    xhr.addEventListener('error', () => {
      error.textContent = 'La subida falló por un problema de red. Inténtalo de nuevo.';
      error.classList.remove('d-none');
      submit.disabled = false;
      bar.classList.remove('progress-bar-animated');
    });

    xhr.open('POST', form.action || window.location.href);
    xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
    xhr.send(new FormData(form));
  });
</script>
