<Window x:Class="GvrTools.Licensing.Activation.AccountLicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GVR Tools · Cuenta / Licencia"
        Height="360" Width="440" MinHeight="320" MinWidth="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/GvrTools.UI;component/Theme/GvrTheme.xaml"/>
    </Window.Resources>

    <Grid Margin="{StaticResource Gvr.Padding.Window}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding StatusHeadline}" Style="{StaticResource Gvr.Text.Title}"/>
            <TextBlock Text="{Binding PlanSummary}" Style="{StaticResource Gvr.Text.Subtle}" Margin="0,6,0,0"/>
            <TextBlock Text="{Binding GraceSummary}" Style="{StaticResource Gvr.Text.Subtle}" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding QuotaSummary}" Style="{StaticResource Gvr.Text.Subtle}" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding SupportHint}" Style="{StaticResource Gvr.Text.Subtle}" Margin="0,10,0,0"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Gvr.Brush.Danger}"
                       TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Activar…" Style="{StaticResource Gvr.Button}" Command="{Binding ActivateCommand}"/>
            <Button Content="Desactivar este PC" Style="{StaticResource Gvr.Button}" Command="{Binding DeactivateCommand}"/>
            <Button Content="Cerrar" Style="{StaticResource Gvr.Button.Primary}" Command="{Binding CloseCommand}"/>
        </StackPanel>
    </Grid>
</Window>
